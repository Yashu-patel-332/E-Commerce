<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Dashboard | Cartora</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <header class="market-header">
        <a class="brand" href="/dashboard">Cartora</a>
        <form class="search-bar" action="/shop" method="get">
            <input type="search" placeholder="Search products" aria-label="Search products">
            <button type="submit">Search</button>
        </form>
        <nav>
            <a href="/dashboard">Dashboard</a>
            <a href="/shop">Shop</a>
            <a href="/cart">Cart</a>
            <a href="/users/logout">Logout</a>
        </nav>
    </header>

    <main class="dashboard-shell">
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

        <section class="dashboard-hero">
            <div>
                <p class="eyebrow">Hello, <%= user.fullname || 'shopper' %></p>
                <h1>Your shopping, cart, and orders in one place.</h1>
            </div>
            <a class="primary-link compact" href="/shop">Shop now</a>
        </section>

        <section class="metric-grid">
            <article class="metric-card">
                <span>Cart items</span>
                <strong><%= cartCount %></strong>
            </article>
            <article class="metric-card">
                <span>Orders</span>
                <strong><%= orderCount %></strong>
            </article>
            <article class="metric-card">
                <span>Account</span>
                <strong>User</strong>
            </article>
        </section>

        <section>
            <div class="section-heading">
                <p class="eyebrow">Recommended</p>
                <h2>Continue shopping</h2>
            </div>
            <div class="product-grid compact-grid">
                <% products.forEach(function(product) { 
                    const finalPrice = Math.max((product.price || 0) - (product.discount || 0), 0);
                %>
                    <article class="product-card" style="--card-bg:<%= product.bgcolor || '#f1f5f9' %>; --panel:<%= product.panecolor || '#184f43' %>; --panel-text:<%= product.textcolor || '#ffffff' %>;">
                        <div class="product-media">
                            <img src="<%= product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=900&q=80' %>" alt="<%= product.name %>">
                        </div>
                        <div class="product-info">
                            <h2><%= product.name %></h2>
                            <div class="price-row">
                                <span>Rs <%= finalPrice.toLocaleString('en-IN') %></span>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>
    </main>
</body>
</html>
