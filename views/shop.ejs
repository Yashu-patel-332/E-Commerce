<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | Cartora</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <header class="market-header">
        <a class="brand" href="/shop">Cartora</a>
        <form class="search-bar" action="/shop" method="get">
            <input type="search" placeholder="Search products" aria-label="Search products">
            <button type="submit">Search</button>
        </form>
        <nav>
            <a href="/dashboard">Dashboard</a>
            <a href="/shop">Shop</a>
            <a href="/cart">Cart</a>
            <% if (user.isAdmin) { %>
                <a href="/products/create">Add product</a>
            <% } %>
            <a href="/users/logout">Logout</a>
        </nav>
    </header>

    <main class="shop-shell">
        <section class="shop-intro">
            <div>
                <p class="eyebrow">Hello, <%= user.fullname || 'shopper' %></p>
                <h1>Deals, essentials, and everyday favorites.</h1>
            </div>
            <a class="primary-link compact" href="/cart">View cart</a>
        </section>

        <section class="product-grid">
            <% products.forEach(function(product) { 
                const finalPrice = Math.max((product.price || 0) - (product.discount || 0), 0);
            %>
                <article class="product-card" style="--card-bg:<%= product.bgcolor || '#f1f5f9' %>; --panel:<%= product.panecolor || '#184f43' %>; --panel-text:<%= product.textcolor || '#ffffff' %>;">
                    <div class="product-media">
                        <img src="<%= product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=900&q=80' %>" alt="<%= product.name %>">
                    </div>
                    <div class="product-info">
                        <div>
                            <h2><%= product.name %></h2>
                            <p>Fast delivery, trusted checkout, and easy ordering.</p>
                        </div>
                        <div class="price-row">
                            <span>Rs <%= finalPrice.toLocaleString('en-IN') %></span>
                            <% if (product.discount) { %>
                                <del>Rs <%= Number(product.price).toLocaleString('en-IN') %></del>
                            <% } %>
                        </div>
                    </div>
                    <% if (product.isSample) { %>
                        <% if (user.isAdmin) { %>
                            <a class="card-action disabled" href="/products/create">Add real products</a>
                        <% } else { %>
                            <a class="card-action disabled" href="/shop">Preview item</a>
                        <% } %>
                    <% } else if (user.isAdmin) { %>
                        <div class="admin-card-actions">
                            <a href="/products/<%= product._id %>/edit">Edit</a>
                            <form action="/products/<%= product._id %>/delete" method="post">
                                <button type="submit">Delete</button>
                            </form>
                        </div>
                    <% } else { %>
                        <form action="/products/<%= product._id %>/cart" method="post">
                            <button class="card-action" type="submit">Add to cart</button>
                        </form>
                    <% } %>
                </article>
            <% }) %>
        </section>
    </main>
</body>
</html>
